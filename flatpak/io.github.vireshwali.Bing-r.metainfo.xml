  <name>Bing-r</name>
  <summary>A modern desktop IPTV and media player</summary>
  <description>
    <p>
      Bingr is a high-performance desktop media client for Live TV, VOD,
      library management, and playback. Import M3U playlists, browse channels
      by category and country, and watch with hardware-accelerated mpv playback.
    </p>
    <p>Features:</p>
    <ul>
      <li>M3U playlist import from files and URLs</li>
      <li>Channel browsing with category and country filters</li>
      <li>Hardware-accelerated playback via mpv</li>
      <li>Favorites and visit tracking</li>
      <li>Dark theme with modern Qt Quick UI</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.vireshwali.Bing-r.desktop</launchable>
