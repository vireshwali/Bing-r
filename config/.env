# =============================================================================
# Bingr Configuration
# =============================================================================
# This file is shipped with the application.  Local overrides go in
# .env.local (sibling file, gitignored) or ~/.config/bingr/.env.
# Path properties are computed by Config class (XDG-aware).

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite database filename (stored inside the data directory).
db.name=bingr.db

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
log.level=DEBUG

# ── File cache (iptv-org API JSONs) ───────────────────────────────────────────
# How many days before re-downloading cached iptv-org API files
# (countries.json, channels.json, streams.json, etc.).
file.cache.ttl=7

# ── Download timeout ──────────────────────────────────────────────────────────
# HTTP timeout in seconds when downloading M3U playlists from user URLs
download.timeout=120

# ── Data cache (in-memory DB query cache) ─────────────────────────────────────
# TTL in seconds for cached database query results.  0 = disabled.
data.cache.ttl=300